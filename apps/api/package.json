{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--import ./src/observability/otel.mjs\" nitro dev",
    "build": "nitro build",
    "start": "cross-env NODE_ENV=production node --import ./src/observability/otel.mjs .output/server/index.mjs",
    "preview": "nitro preview",
    "smoke": "./scripts/smoke.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/data-access/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/data-access/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/data-access/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/data-access/db/drizzle.config.ts",
    "auth:generate": "npx @better-auth/cli generate --config=src/auth/auth.cli.ts",
    "auth:migrate": "npx @better-auth/cli migrate --config=src/auth/auth.cli.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.20",
    "@hono/trpc-server": "^0.4.2",
    "@myapp/shared": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@trpc/server": "^11.28.0",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.5",
    "h3": "^2.0.8",
    "hono": "^4.13.17",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6",
    "typescript-eslint": "^8.72.2"
  }
}