{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--import ./src/server/observability/otel.mjs\" nitro dev",
    "build": "nitro build",
    "start": "cross-env NODE_ENV=production node --import ./src/server/observability/otel.mjs .output/server/index.mjs",
    "preview": "nitro preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/server/data-access/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/server/data-access/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/server/data-access/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/server/data-access/db/drizzle.config.ts",
    "auth:generate": "npx @better-auth/cli generate --config=src/server/auth/auth.cli.ts",
    "auth:migrate": "npx @better-auth/cli migrate --config=src/server/auth/auth.cli.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-auth": "^1.7.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "h3": "^2.0.1-rc.31",
    "hono": "^4.13.7",
    "nitro": "^3.0.260903-beta",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10",
    "globals": "^17",
    "prettier": "^3.8.3",
    "typescript": "~6",
    "typescript-eslint": "^8"
  }
}
