# Copy to .env.local for local development (loaded when NODE_ENV isn't production).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173

# Social sign-in (optional): each provider is on only when its id and secret are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=

# Object storage (S3 API). Locally: Garage from docker-compose, after infra/garage/init.sh.
# These dev values are local-only, not secrets.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_ACCESS_KEY_ID=GK0123456789abcdef01234567
STORAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_UPLOADS_BUCKET=myapp-uploads-dev
STORAGE_MEDIA_BUCKET=myapp-media-dev
STORAGE_MEDIA_PUBLIC_URL=http://myapp-media-dev.web.garage.localhost:3902

# Cloudflare R2 instead:
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=<R2 API token access key id>
# STORAGE_SECRET_ACCESS_KEY=<R2 API token secret>
# STORAGE_UPLOADS_BUCKET=myapp-uploads-prod
# STORAGE_MEDIA_BUCKET=myapp-media-prod
# STORAGE_MEDIA_PUBLIC_URL=https://media.example.com   (the media bucket's public custom domain)
