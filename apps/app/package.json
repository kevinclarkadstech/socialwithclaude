{
  "name": "app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--import ./src/server/observability/otel.mjs\" NITRO_DEV_RUNNER=node-process vite",
    "build": "tsc -b && vite build",
    "start": "node --import tsx --import ./src/server/otel-register.ts .output/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate --config=src/server/data-access/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/server/data-access/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/server/data-access/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/server/data-access/db/drizzle.config.ts",
    "auth:generate": "npx @better-auth/cli generate --config=src/server/auth/auth.cli.ts",
    "auth:migrate": "npx @better-auth/cli migrate --config=src/server/auth/auth.cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "h3": "^2.0.1-rc.31",
    "hono": "^4.13.7",
    "nitro": "^3.0.260903-beta",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.13",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}