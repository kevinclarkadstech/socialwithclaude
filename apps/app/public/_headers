# Response headers for the web app on Cloudflare (see wrangler.jsonc); copied into dist by the build.

# Every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Built scripts and styles have a hash in their names, so a new build never reuses a name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Universal Links: Apple reads this as JSON, but the file has no extension to say so.
/.well-known/apple-app-site-association
  Content-Type: application/json
