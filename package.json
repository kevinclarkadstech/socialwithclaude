{
    "name": "simple",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n api,web -c green,blue \"bun run --cwd apps/api dev\" \"bun run --cwd apps/web dev\""
    },
    "devDependencies": {
        "@types/bun": "^1.4.0",
        "concurrently": "^10.0.5",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "zod": "^4.5.4"
    }
}